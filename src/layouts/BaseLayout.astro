---
import SiteHeader from "@/components/SiteHeader.astro";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  theme?: "dark" | "light";
  noindex?: boolean;
}

const {
  title,
  description,
  theme = "dark",
  noindex = false
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const pageTitle = title === "Quantum Hub" ? title : `${title} — Quantum Hub`;
---

<!doctype html>
<html lang="en" data-theme={theme} data-active-phase="signal" data-render-mode="static">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/brand/quantum-icon-color.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === "dark" ? "#0b0a0d" : "#e8e7e1"} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quantum Hub" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader />
    <slot />
  </body>
</html>
