---
const pathname = Astro.url.pathname;
const links = [
  { href: "/proof/", label: "Proof" },
  { href: "/industry/", label: "Industry" },
  { href: "/startups/", label: "Startups" },
  { href: "/programs/", label: "Programs" },
  { href: "/network/", label: "Network" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" }
];

const isCurrent = (href: string) =>
  pathname === href ||
  pathname === href.slice(0, -1) ||
  (href !== "/" && pathname.startsWith(href));
---

<header class="site-header" data-site-header>
  <a class="wordmark" href="/" aria-label="Quantum Hub home">
    <img
      class="wordmark__asset wordmark__asset--full wordmark__asset--on-dark"
      src="/brand/quantum-full-logo-white.svg"
      width="242"
      height="182"
      alt=""
      aria-hidden="true"
    />
    <img
      class="wordmark__asset wordmark__asset--full wordmark__asset--on-light"
      src="/brand/quantum-full-logo-colors.svg"
      width="242"
      height="182"
      alt=""
      aria-hidden="true"
    />
    <img
      class="wordmark__asset wordmark__asset--icon wordmark__asset--on-dark"
      src="/brand/quantum-icon-white.svg"
      width="109"
      height="109"
      alt=""
      aria-hidden="true"
    />
    <img
      class="wordmark__asset wordmark__asset--icon wordmark__asset--on-light"
      src="/brand/quantum-icon-color.svg"
      width="109"
      height="109"
      alt=""
      aria-hidden="true"
    />
  </a>

  <details class="nav-disclosure" open data-nav-disclosure>
    <summary aria-label="Toggle primary navigation">
      <span class="nav-disclosure__label">Menu</span>
      <span class="nav-disclosure__glyph" aria-hidden="true"></span>
    </summary>
    <nav aria-label="Primary">
      <ol>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
</header>

<script>
  const disclosure = document.querySelector<HTMLDetailsElement>("[data-nav-disclosure]");
  const mobile = window.matchMedia("(max-width: 52rem)");

  const syncDisclosure = () => {
    if (!disclosure) return;
    disclosure.open = !mobile.matches;
  };

  syncDisclosure();
  mobile.addEventListener("change", syncDisclosure);

  disclosure?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (mobile.matches) disclosure.open = false;
    });
  });
</script>
