---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<main id="main-content" class="route-shell">
  <div class="route-shell__field" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <article class="route-shell__copy">
    <p class="kicker">{eyebrow}</p>
    <h1>{title}</h1>
    <p>{description}</p>
    <p class="publication-note" data-development-placeholder="route-shell">
      <span>Phase 1 route shell</span>
      Approved content and media pending.
    </p>
    <a class="text-link" href="/">Return to the field <span aria-hidden="true">↗</span></a>
  </article>
</main>
