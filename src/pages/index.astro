---
import ExperienceStage from "@/components/ExperienceStage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  findSelection,
  findSequence,
  homepageActs,
  homepageProofFields,
} from "@/content/homepage";
import { maradinProofRecord } from "@/content/proof";

const [signal, aperture, need, find, test, prove] = homepageActs;
if (!signal || !aperture || !need || !find || !test || !prove) {
  throw new Error("The six approved homepage acts are required.");
}

const aperturePoster = maradinProofRecord.media.find(
  (asset) => asset.id === "maradin-field-aperture-poster",
);
const testFilm = maradinProofRecord.media.find(
  (asset) => asset.id === "maradin-test-contact-video",
);
const proveFrame = maradinProofRecord.media.find(
  (asset) => asset.id === "maradin-prove-field-frame",
);
const supportingStill = maradinProofRecord.media.find(
  (asset) => asset.id === "maradin-real-field-still",
);
const { startup, operatingOrganization, program } = maradinProofRecord;

if (
  !aperturePoster ||
  !testFilm ||
  !proveFrame ||
  !supportingStill ||
  !startup ||
  !operatingOrganization ||
  !program
) {
  throw new Error("The approved Maradin homepage record is incomplete.");
}
---

<BaseLayout
  title="Quantum Hub"
  description="Quantum Hub turns industrial needs into field evidence through technology search, practical testing, and proof."
>
  <ExperienceStage />

  <nav class="phase-index" aria-label="Experience phases">
    <ol>
      {homepageActs.map((act) => (
        <li>
          <a href={`#${act.phase}`} data-phase-link={act.phase}>
            <span>{act.act}</span>
            <span>{act.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <main id="main-content" class="experience" data-experience>
    <section
      id="signal"
      class="act act--signal"
      data-experience-phase="signal"
      aria-labelledby="signal-title"
    >
      <div class="act__inner act__inner--signal">
        <p class="act-number"><span>Act</span> {signal.act} / {signal.label}</p>
        <h1 id="signal-title" class="display display--hero">
          <span>{signal.title[0]}</span>
          <span>{signal.title[1]}</span>
        </h1>
        <div class="signal-footer">
          <p class="phase-copy">
            <span>Operating logic</span>
            {signal.supporting}
          </p>
          <a class="scroll-cue" href="#aperture">
            <span>Trace the signal</span>
            <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
    </section>

    <section
      id="aperture"
      class="act act--aperture"
      data-experience-phase="aperture"
      data-approved-media="maradin-field-aperture"
      aria-labelledby="aperture-title"
    >
      <div class="act__inner act__inner--aperture">
        <div class="aperture-copy">
          <p class="act-number"><span>Act</span> {aperture.act} / {aperture.label}</p>
          <h2 id="aperture-title" class="display display--aperture">
            <span>{aperture.title[0]}</span>
            <span>{aperture.title[1]}</span>
          </h2>
          <p class="phase-copy phase-copy--plate">
            <span>Approved field record</span>
            {aperture.supporting}
          </p>
        </div>
        <div class="aperture-readout" aria-label="Field aperture transition">
          <p><span>Layer 01</span> Abstract signal</p>
          <p><span>Layer 02</span> Maradin field test</p>
          <p><span>State</span> Real environment emerging</p>
        </div>
      </div>
    </section>

    <section
      id="need"
      class="act act--need"
      data-experience-phase="need"
      aria-labelledby="need-title"
    >
      <div class="act__inner act__inner--need">
        <p class="act-number"><span>Act</span> {need.act} / {need.label}</p>
        <div class="need-composition">
          <p class="need-label">Field condition</p>
          <h2 id="need-title" class="display display--need">
            <span>{need.title[0]}</span>
            <span>{need.title[1]}</span>
          </h2>
          <p class="phase-copy phase-copy--vertical">
            <span>Approved need</span>
            {need.supporting}
          </p>
        </div>
        <dl class="need-terms">
          <div><dt>01</dt><dd>Visual clarity</dd></div>
          <div><dt>02</dt><dd>Nearby road users</dd></div>
          <div><dt>03</dt><dd>Real conditions</dd></div>
        </dl>
      </div>
    </section>

    <section
      id="find"
      class="act act--find"
      data-experience-phase="find"
      aria-labelledby="find-title"
    >
      <div class="act__inner act__inner--find">
        <header class="find-heading">
          <p class="act-number"><span>Act</span> {find.act} / {find.label}</p>
          <h2 id="find-title" class="display display--find">
            <span>{find.title[0]}</span>
            <span>{find.title[1]}</span>
          </h2>
          <p class="phase-copy">
            <span>Controlled search</span>
            {find.supporting}
          </p>
        </header>

        <ol class="find-sequence">
          {findSequence.map((item, index) => (
            <li
              class:list={{ "is-selected": index === findSequence.length - 1 }}
              data-find-step={["landscape", "adjacency", "selection"][index]}
            >
              <span>{item.index}</span>
              <strong>{item.label}</strong>
              <small>{item.description}</small>
            </li>
          ))}
        </ol>

        <aside class="find-selection" aria-label="Selected technology">
          <p>Selected technology</p>
          <strong>{findSelection.startup?.name}</strong>
          <span>{findSelection.method}</span>
          <span>{findSelection.title}</span>
        </aside>
      </div>
    </section>

    <section
      id="test"
      class="act act--test"
      data-experience-phase="test"
      aria-labelledby="test-title"
    >
      <div class="act__inner act__inner--test">
        <header class="test-heading">
          <p class="act-number"><span>Act</span> {test.act} / {test.label}</p>
          <h2 id="test-title" class="display display--test">
            <span>{test.title[0]}</span>
            <span>{test.title[1]}</span>
          </h2>
        </header>

        <div class="test-boundary" data-approved-media="maradin-test-contact">
          <video
            class="test-boundary__media"
            data-documentary-video
            data-media-phase="test"
            data-poster={proveFrame.src}
            muted
            playsinline
            loop
            preload="none"
            tabindex="-1"
            aria-hidden="true"
          >
            <source data-src={testFilm.src} type="video/mp4" />
          </video>
          <div class="test-boundary__content">
            <p class="test-boundary__statement">{test.supporting}</p>
            <dl>
              <div><dt>Mount</dt><dd>Vehicle-mounted field test</dd></div>
              <div><dt>Positions</dt><dd>Multiple projector positions</dd></div>
              <div><dt>Conditions</dt><dd>Road surfaces, light and weather</dd></div>
              <div><dt>Scenarios</dt><dd>More than 60 real-world scenarios</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section
      id="prove"
      class="act act--prove"
      data-experience-phase="prove"
      aria-labelledby="prove-title"
    >
      <div class="act__inner act__inner--prove">
        <header class="prove-heading">
          <p class="act-number"><span>Act</span> {prove.act} / {prove.label}</p>
          <h2 id="prove-title" class="display display--prove">
            <span>{prove.title[0]}</span>
            <span>{prove.title[1]}</span>
          </h2>
          <p>{prove.supporting}</p>
        </header>

        <article class="proof-record" data-proof-record={maradinProofRecord.slug}>
          <header>
            <div>
              <p>Proof / approved public record</p>
              <h3>{maradinProofRecord.title}</h3>
            </div>
            <span>{startup.name} / {program.name}</span>
          </header>

          <figure class="proof-record__media">
            <img
              class="proof-record__image proof-record__image--primary"
              src={proveFrame.src}
              alt={proveFrame.alt}
              width={proveFrame.width}
              height={proveFrame.height}
              loading="lazy"
              decoding="async"
            />
            <img
              class="proof-record__image proof-record__image--supporting"
              src={supportingStill.src}
              alt={supportingStill.alt}
              width={supportingStill.width}
              height={supportingStill.height}
              loading="lazy"
              decoding="async"
            />
            <figcaption>Field evidence / approved documentary stills</figcaption>
          </figure>

          <dl>
            {homepageProofFields.map((field, index) => (
              <div>
                <dt><span>{String(index + 1).padStart(2, "0")}</span>{field.label}</dt>
                <dd>{field.value}</dd>
              </div>
            ))}
          </dl>
          <footer>
            <p>{operatingOrganization.name} / {program.name} / comparative field evidence</p>
            <a href="/proof/">View proof architecture <span aria-hidden="true">↗</span></a>
          </footer>
        </article>

        <footer class="experience-end">
          <p>Phase 2 / Real field evidence integrated</p>
          <p>Human review decides the checkpoint.</p>
        </footer>
      </div>
    </section>
  </main>

  <script>
    import "@/scripts/experience-controller";
  </script>
</BaseLayout>
