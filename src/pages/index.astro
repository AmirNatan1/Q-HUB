---
import PartnerField from "@/components/PartnerField.astro";
import QuantumStage from "@/components/QuantumStage.astro";
import {
  activitySignals,
  homepageActs,
  methodStates,
} from "@/content/homepage";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/phase-r.css";

const [presence, access, startup, method, activity, evidence, action] = homepageActs;

if (!presence || !access || !startup || !method || !activity || !evidence || !action) {
  throw new Error("The seven approved Phase R homepage acts are required.");
}
---

<BaseLayout
  title="Where Industry Meets Technology"
  description="Quantum Hub connects technology with industrial partners, real operating environments, and a path from need to field evidence."
  initialPhase="presence"
>
  <QuantumStage />

  <main id="main-content" class="phase-r-homepage" data-experience>
    <section
      id="presence"
      class="phase-r-act phase-r-act--presence"
      data-experience-phase="presence"
      data-presence-state="origin"
      aria-labelledby="presence-title"
    >
      <div class="phase-r-act__sticky phase-r-presence">
        <h1 id="presence-title" class="phase-r-display phase-r-display--presence" data-stage-keepout>
          <span>{presence.title[0]?.split(" ")[0]}</span>
          <span>{presence.title[0]?.split(" ")[1]}</span>
        </h1>
        <p class="phase-r-presence__resolve">{presence.supporting}</p>
        <a class="phase-r-scroll-cue" href="#access">
          <span>Enter Quantum</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <section
      id="access"
      class="phase-r-act phase-r-act--access"
      data-experience-phase="access"
      data-partner-state="opening"
      aria-labelledby="access-title"
    >
      <div class="phase-r-act__sticky phase-r-access">
        <header class="phase-r-access__heading">
          <h2 id="access-title" class="phase-r-display phase-r-display--access" data-stage-keepout>
            {access.title[0]}
          </h2>
        </header>
        <PartnerField />
      </div>
    </section>

    <section
      id="startup"
      class="phase-r-act phase-r-act--startup"
      data-experience-phase="startup"
      data-crossing-state="outside"
      aria-labelledby="startup-title"
    >
      <div class="phase-r-act__sticky phase-r-startup">
        <div class="field-crossing" data-field-crossing aria-hidden="true">
          <span class="field-crossing__signal"></span>
          <span class="field-crossing__threshold"></span>
          <span class="field-crossing__field"></span>
        </div>
        <div class="phase-r-startup__copy">
          <h2 id="startup-title" class="phase-r-display phase-r-display--startup" data-stage-keepout>
            {startup.title.map((line) => <span>{line}</span>)}
          </h2>
          <p>{startup.supporting}</p>
          {startup.action && (
            <a
              class="phase-r-action"
              href={startup.action.href}
              data-startup-action
            >
              {startup.action.label}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section
      id="method"
      class="phase-r-act phase-r-act--method"
      data-experience-phase="method"
      data-method-state="find"
      aria-labelledby="method-title"
    >
      <div class="phase-r-act__sticky phase-r-method">
        <div class="phase-r-method__copy">
          <h2 id="method-title" class="phase-r-display phase-r-display--method" data-stage-keepout>
            {methodStates.map((state) => (
              <span data-method-word={state}>{state}.</span>
            ))}
          </h2>
          <p>{method.supporting}</p>
        </div>
        <div class="method-instrument" aria-hidden="true">
          <span class="method-instrument__wide"></span>
          <span class="method-instrument__contact"></span>
          <span class="method-instrument__record"></span>
        </div>
      </div>
    </section>

    <section
      id="activity"
      class="phase-r-act phase-r-act--activity"
      data-experience-phase="activity"
      aria-labelledby="activity-title"
    >
      <div class="phase-r-act__sticky phase-r-activity">
        <h2 id="activity-title" class="phase-r-display phase-r-display--activity" data-stage-keepout>
          {activity.title[0]}
        </h2>
        <ul class="activity-signals" aria-label="Quantum activity">
          {activitySignals.map((signal, index) => (
            <li style={`--activity-index: ${index}`}>{signal}</li>
          ))}
        </ul>
      </div>
    </section>

    <section
      id="evidence"
      class="phase-r-act phase-r-act--evidence"
      data-experience-phase="evidence"
      aria-labelledby="evidence-title"
    >
      <div class="phase-r-act__sticky phase-r-evidence">
        <div class="phase-r-evidence__index" aria-hidden="true">
          <span>01</span><span>02</span><span>03</span><span>04</span>
        </div>
        <div class="phase-r-evidence__copy">
          <h2 id="evidence-title" class="phase-r-display phase-r-display--evidence" data-stage-keepout>
            {evidence.title.map((line) => <span>{line}</span>)}
          </h2>
          {evidence.action && (
            <a
              class="phase-r-action phase-r-action--light"
              href={evidence.action.href}
              data-proof-handoff
            >
              {evidence.action.label}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section
      id="action"
      class="phase-r-act phase-r-act--action"
      data-experience-phase="action"
      aria-labelledby="action-title"
    >
      <div class="phase-r-act__sticky phase-r-ending">
        <div class="phase-r-ending__copy">
          <h2 id="action-title" class="phase-r-display phase-r-display--ending" data-stage-keepout>
            {action.title.map((line) => <span>{line}</span>)}
          </h2>
          {action.action && (
            <a
              class="phase-r-action phase-r-action--primary"
              href={action.action.href}
              data-work-with-quantum
            >
              {action.action.label}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
        <p class="phase-r-ending__mark">Quantum Hub</p>
      </div>
    </section>
  </main>

  <script>
    import "@/scripts/experience-controller";
  </script>
</BaseLayout>
