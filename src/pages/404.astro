---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Field not found"
  description="The requested Quantum Hub route could not be found."
  noindex
>
  <main id="main-content" class="not-found">
    <p class="kicker">404 / Outside the field</p>
    <h1>Signal lost.</h1>
    <p>The route you followed does not resolve to a field record.</p>
    <a class="text-link" href="/">Return to the experience <span aria-hidden="true">↗</span></a>
  </main>
</BaseLayout>
